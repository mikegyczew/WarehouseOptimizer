<!DOCTYPE html>
<html lang="pl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>WarehouseOptimizer</title>

    <link
        rel="stylesheet"
        href="/static/style.css"
    >

    <style>

        /* =====================================================
           3D SCENE
        ===================================================== */

        #scene {
            position: relative;
            overflow: hidden;
        }

        #scene canvas {
            display: block;
            width: 100%;
            height: 100%;
            touch-action: none;
            cursor: grab;
        }

        #scene canvas:active {
            cursor: grabbing;
        }


        /* =====================================================
           ANIMATION PROGRESS
        ===================================================== */

        .warehouse-animation-info {
            position: absolute;
            top: 16px;
            left: 16px;
            z-index: 20;
            min-width: 250px;
            padding: 12px 14px;
            border-radius: 12px;
            background: rgba(10, 18, 32, .90);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, .08);
            color: white;
            pointer-events: none;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .25);
        }

        .warehouse-animation-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .warehouse-progress-track {
            height: 7px;
            background: rgba(255,255,255,.12);
            border-radius: 10px;
            overflow: hidden;
        }

        .warehouse-progress {
            width: 0%;
            height: 100%;
            border-radius: 10px;
            background: #3b82f6;
            transition: width .08s linear;
        }

        .warehouse-progress-label {
            margin-top: 6px;
            font-size: 11px;
            opacity: .7;
        }


        /* =====================================================
           VOLUME LEGEND
        ===================================================== */

        .volume-legend {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .volume-legend span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .volume-legend .legend-box {
            width: 11px;
            height: 11px;
            border-radius: 3px;
            display: inline-block;
        }


        /* =====================================================
           3D INFO
        ===================================================== */

        #warehouse3dInfo {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }


        /* =====================================================
           VOLUME LEGEND INSIDE 3D
        ===================================================== */

        #warehouse3dLegend {
            position: absolute;
            top: 16px;
            right: 16px;
            z-index: 20;
            min-width: 150px;
            padding: 12px 14px;
            border-radius: 12px;
            background: rgba(10, 18, 32, .90);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, .08);
            color: white;
            pointer-events: none;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .25);
        }

        .warehouse-legend-title {
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 9px;
            letter-spacing: .05em;
        }

        .warehouse-legend-row {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 5px;
            font-size: 11px;
            color: #cbd5e1;
        }

        .warehouse-legend-color {
            width: 12px;
            height: 12px;
            border-radius: 3px;
            flex-shrink: 0;
        }

    </style>

</head>


<body>


<div class="app-shell">


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                📦
            </div>

            <div>

                <strong>
                    Warehouse
                </strong>

                <span>
                    Optimizer
                </span>

            </div>

        </div>


        <nav>

            <button
                class="nav-item active"
                onclick="showView('dashboard')"
            >

                <span>▦</span>

                Dashboard

            </button>


            <button
                class="nav-item"
                onclick="showView('warehouse')"
            >

                <span>⌗</span>

                Magazyn

            </button>


            <button
                class="nav-item"
                onclick="showView('packages')"
            >

                <span>▣</span>

                Towary

            </button>


            <button
                class="nav-item"
                onclick="showView('settings')"
            >

                <span>⚙</span>

                Ustawienia

            </button>

        </nav>


        <div class="sidebar-bottom">

            <div class="engine-status">

                <div class="status-dot"></div>

                <div>

                    <strong>
                        Optimizer Engine
                    </strong>

                    <span>
                        System gotowy
                    </span>

                </div>

            </div>


            <div class="version">
                v0.1 prototype
            </div>

        </div>

    </aside>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="main">


        <!-- =================================================
             TOPBAR
        ================================================== -->

        <header class="topbar">

            <div>

                <div class="breadcrumb">

                    Warehouse /

                    <strong>
                        Projekt magazynu
                    </strong>

                </div>

                <h1>
                    Optymalizacja przestrzeni
                </h1>

            </div>


            <div class="topbar-actions">

                <button
                    class="icon-button"
                    onclick="loadDemo()"
                    title="Załaduj dane demonstracyjne"
                >

                    ▶

                </button>


                <div class="user">

                    <div class="avatar">
                        MG
                    </div>

                    <div>

                        <strong>
                            Magazyn
                        </strong>

                        <span>
                            Administrator
                        </span>

                    </div>

                </div>

            </div>

        </header>



        <!-- =================================================
             DASHBOARD
        ================================================== -->

        <section
            id="dashboardView"
            class="view"
        >


            <!-- STATS -->

            <div class="stats-grid">


                <div class="stat-card">

                    <div class="stat-icon blue">
                        ▣
                    </div>

                    <div>

                        <span>
                            Towary
                        </span>

                        <strong id="dashboardPackages">
                            0
                        </strong>

                        <small>
                            sztuk do rozmieszczenia
                        </small>

                    </div>

                </div>



                <div class="stat-card">

                    <div class="stat-icon green">
                        ◉
                    </div>

                    <div>

                        <span>
                            Wykorzystanie
                        </span>

                        <strong id="dashboardUsage">
                            0%
                        </strong>

                        <small>
                            zajętej przestrzeni
                        </small>

                    </div>

                </div>



                <div class="stat-card">

                    <div class="stat-icon orange">
                        □
                    </div>

                    <div>

                        <span>
                            Przestrzeń
                        </span>

                        <strong id="dashboardRoom">
                            0 m³
                        </strong>

                        <small>
                            objętość magazynu
                        </small>

                    </div>

                </div>



                <div class="stat-card">

                    <div class="stat-icon purple">
                        ✓
                    </div>

                    <div>

                        <span>
                            Umieszczone
                        </span>

                        <strong id="dashboardPlaced">
                            0
                        </strong>

                        <small>
                            poprawnie rozmieszczonych
                        </small>

                    </div>

                </div>

            </div>



            <!-- WORKSPACE -->

            <div class="workspace">


                <div class="workspace-main">


                    <!-- 3D PANEL -->

                    <div class="panel viewer-panel">


                        <div class="panel-header">

                            <div>

                                <div class="panel-label">
                                    LIVE 3D VIEW
                                </div>

                                <h2>
                                    Mapa magazynu
                                </h2>

                            </div>


                            <div class="viewer-controls">

                                <button
                                    onclick="resetCamera()"
                                    title="Reset kamery"
                                >
                                    ⟳
                                </button>


                                <button
                                    onclick="toggleGrid()"
                                    title="Siatka"
                                >
                                    #
                                </button>


                                <button
                                    onclick="fitCamera()"
                                    title="Dopasuj widok"
                                >
                                    ⛶
                                </button>

                            </div>

                        </div>



                        <!-- 3D SCENE -->

                        <div
                            id="scene"
                            class="scene"
                        >


                            <div
                                id="scenePlaceholder"
                                class="scene-placeholder"
                            >

                                <div class="placeholder-icon">
                                    📦
                                </div>

                                <strong>
                                    Przygotuj magazyn
                                </strong>

                                <span>
                                    Wprowadź wymiary i towary,
                                    aby rozpocząć optymalizację.
                                </span>

                                <button
                                    onclick="showView('warehouse')"
                                >

                                    Skonfiguruj magazyn →

                                </button>

                            </div>



                            <!-- ANIMATION STATUS -->

                            <div
                                id="warehouseAnimationInfo"
                                class="warehouse-animation-info"
                            >

                                <div
                                    id="warehouseProgressTitle"
                                    class="warehouse-animation-title"
                                >
                                    Rozmieszczanie paczek
                                </div>


                                <div
                                    class="warehouse-progress-track"
                                >

                                    <div
                                        id="warehouseProgress"
                                        class="warehouse-progress"
                                    ></div>

                                </div>


                                <div
                                    id="warehouseProgressLabel"
                                    class="warehouse-progress-label"
                                >
                                    0 / 0 · 0%
                                </div>

                            </div>


                        </div>



                        <!-- FOOTER -->

                        <div class="viewer-footer">

                            <div class="legend volume-legend">

                                <span>

                                    <i
                                        class="legend-box"
                                        style="background:#2677ff;"
                                    ></i>

                                    Małe

                                </span>


                                <span>

                                    <i
                                        class="legend-box"
                                        style="background:#34b85a;"
                                    ></i>

                                    Małe / średnie

                                </span>


                                <span>

                                    <i
                                        class="legend-box"
                                        style="background:#e6c52f;"
                                    ></i>

                                    Średnie

                                </span>


                                <span>

                                    <i
                                        class="legend-box"
                                        style="background:#ed8a24;"
                                    ></i>

                                    Duże

                                </span>


                                <span>

                                    <i
                                        class="legend-box"
                                        style="background:#e53935;"
                                    ></i>

                                    Największe

                                </span>


                                <span>

                                    <i class="legend-box orange"></i>

                                    Wybrana

                                </span>

                            </div>


                            <span class="mouse-help">

                                🖱 Przeciągnij · scroll = zoom

                            </span>

                        </div>


                    </div>


                </div>



                <!-- =================================================
                     RIGHT PANEL
                ================================================== -->

                <aside class="workspace-side">


                    <!-- OPTIMIZATION -->

                    <div class="panel optimization-card">

                        <div class="panel-label">
                            OPTYMALIZACJA
                        </div>

                        <h3>
                            Gotowy do obliczeń?
                        </h3>

                        <p>
                            Silnik przeanalizuje orientacje
                            oraz możliwe pozycje paczek.
                        </p>


                        <button
                            class="optimize-button"
                            onclick="optimize()"
                        >

                            <span>
                                🚀
                            </span>

                            Uruchom optymalizację

                        </button>


                        <div
                            id="loading"
                            class="loading hidden"
                        >

                            <div class="spinner"></div>

                            <span>
                                Obliczam rozmieszczenie...
                            </span>

                        </div>

                    </div>



                    <!-- ROOM -->

                    <div class="panel">

                        <div class="panel-header small">

                            <div>

                                <div class="panel-label">
                                    PRZESTRZEŃ
                                </div>

                                <h3>
                                    Magazyn
                                </h3>

                            </div>


                            <button
                                class="edit-button"
                                onclick="showView('warehouse')"
                            >

                                Edytuj

                            </button>

                        </div>


                        <div class="room-preview">

                            <div>

                                <span>
                                    Długość
                                </span>

                                <strong id="sideLength">
                                    —
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Szerokość
                                </span>

                                <strong id="sideWidth">
                                    —
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Wysokość
                                </span>

                                <strong id="sideHeight">
                                    —
                                </strong>

                            </div>

                        </div>

                    </div>



                    <!-- RESULT -->

                    <div class="panel result-mini">

                        <div class="panel-label">
                            WYNIK
                        </div>


                        <div class="usage-circle">

                            <div>

                                <strong id="circleUsage">
                                    0%
                                </strong>

                                <span>
                                    wykorzystania
                                </span>

                            </div>

                        </div>


                        <div class="mini-stats">

                            <div>

                                <span>
                                    Umieszczone
                                </span>

                                <strong id="miniPlaced">
                                    0
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Brak miejsca
                                </span>

                                <strong id="miniNotPlaced">
                                    0
                                </strong>

                            </div>

                        </div>

                    </div>



                    <!-- SELECTED BOX -->

                    <div
                        class="panel selected-box-panel hidden"
                        id="selectedBoxPanel"
                    >

                        <div class="panel-label">
                            WYBRANA PACZKA
                        </div>


                        <h3 id="selectedBoxName">
                            —
                        </h3>


                        <div class="selected-box-data">


                            <div>

                                <span>
                                    Długość
                                </span>

                                <strong id="selectedLength">
                                    —
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Szerokość
                                </span>

                                <strong id="selectedWidth">
                                    —
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Wysokość
                                </span>

                                <strong id="selectedHeight">
                                    —
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Pozycja
                                </span>

                                <strong id="selectedPosition">
                                    —
                                </strong>

                            </div>


                        </div>


                    </div>


                </aside>


            </div>


        </section>



        <!-- =================================================
             WAREHOUSE
        ================================================== -->

        <section
            id="warehouseView"
            class="view hidden"
        >

            <div class="page-title">

                <div>

                    <div class="panel-label">
                        KONFIGURACJA
                    </div>

                    <h2>
                        Wymiary magazynu
                    </h2>

                    <p>
                        Zdefiniuj przestrzeń,
                        którą chcesz zoptymalizować.
                    </p>

                </div>

            </div>


            <div class="panel form-panel">

                <div class="form-grid">


                    <div class="field">

                        <label>
                            Długość
                        </label>

                        <div class="unit-input">

                            <input
                                id="roomLength"
                                type="number"
                                placeholder="1000"
                                min="1"
                            >

                            <span>
                                cm
                            </span>

                        </div>

                    </div>



                    <div class="field">

                        <label>
                            Szerokość
                        </label>

                        <div class="unit-input">

                            <input
                                id="roomWidth"
                                type="number"
                                placeholder="800"
                                min="1"
                            >

                            <span>
                                cm
                            </span>

                        </div>

                    </div>



                    <div class="field">

                        <label>
                            Wysokość
                        </label>

                        <div class="unit-input">

                            <input
                                id="roomHeight"
                                type="number"
                                placeholder="300"
                                min="1"
                            >

                            <span>
                                cm
                            </span>

                        </div>

                    </div>


                </div>


                <div
                    id="roomInfo"
                    class="info-strip"
                >

                    <div>

                        <span>
                            Objętość magazynu
                        </span>

                        <strong id="roomVolume">
                            0 m³
                        </strong>

                    </div>


                    <div>

                        <span>
                            Podstawa
                        </span>

                        <strong id="roomBase">
                            0 m²
                        </strong>

                    </div>

                </div>


                <button
                    class="save-button"
                    onclick="saveRoom()"
                >

                    Zapisz wymiary

                </button>

            </div>

        </section>



        <!-- =================================================
             PACKAGES
        ================================================== -->

        <section
            id="packagesView"
            class="view hidden"
        >

            <div class="page-title">

                <div>

                    <div class="panel-label">
                        INVENTORY
                    </div>

                    <h2>
                        Towary
                    </h2>

                    <p>
                        Dodaj towary, które mają zostać
                        rozmieszczone w magazynie.
                    </p>

                </div>


                <button
                    class="add-button"
                    onclick="addPackage()"
                >

                    ＋ Dodaj towar

                </button>

            </div>


            <div class="panel">

                <div id="packagesList"></div>


                <div
                    id="emptyPackages"
                    class="empty-packages"
                >

                    <div>
                        📦
                    </div>

                    <strong>
                        Brak towarów
                    </strong>

                    <span>
                        Dodaj pierwszy towar do projektu.
                    </span>

                    <button
                        onclick="addPackage()"
                    >

                        ＋ Dodaj towar

                    </button>

                </div>


                <div class="inventory-summary">

                    <div>

                        <span>
                            Rodzaje
                        </span>

                        <strong id="packageTypes">
                            0
                        </strong>

                    </div>


                    <div>

                        <span>
                            Sztuki
                        </span>

                        <strong id="packageCount">
                            0
                        </strong>

                    </div>


                    <div>

                        <span>
                            Objętość
                        </span>

                        <strong id="packageVolume">
                            0 m³
                        </strong>

                    </div>

                </div>

            </div>

        </section>



        <!-- =================================================
             SETTINGS
        ================================================== -->

        <section
            id="settingsView"
            class="view hidden"
        >

            <div class="page-title">

                <div>

                    <div class="panel-label">
                        SYSTEM
                    </div>

                    <h2>
                        Ustawienia
                    </h2>

                    <p>
                        Konfiguracja prototypu
                        WarehouseOptimizer.
                    </p>

                </div>

            </div>


            <div class="panel settings-panel">


                <div class="setting-row">

                    <div>

                        <strong>
                            Jednostka wymiarów
                        </strong>

                        <span>
                            Jednostka używana podczas projektowania.
                        </span>

                    </div>


                    <select>

                        <option>
                            Centymetry (cm)
                        </option>

                        <option>
                            Metry (m)
                        </option>

                    </select>

                </div>



                <div class="setting-row">

                    <div>

                        <strong>
                            Tryb wizualizacji
                        </strong>

                        <span>
                            Sposób prezentowania magazynu.
                        </span>

                    </div>


                    <select>

                        <option>
                            3D
                        </option>

                        <option>
                            2D
                        </option>

                    </select>

                </div>


            </div>

        </section>


    </main>

</div>



<!-- =========================================================
     THREE.JS
========================================================== -->

<script type="module">

    import * as THREE
        from "/static/three.module.js";

    window.THREE = THREE;

    window.dispatchEvent(
        new Event("three-ready")
    );

</script>



<script>

/* =========================================================
   STATE
========================================================= */

let packageId = 0;

let scene = null;

let camera = null;

let renderer = null;

let animatedBoxes = [];

let animationLoopStarted = false;

let cameraTarget = null;

let cameraDistance = 5;

let cameraAngleX = 0.8;

let cameraAngleY = 0.7;

let roomGroup = null;

let grid = null;

let warehouseObjects = [];

let mouseDown = false;

let isDragging = false;

let pointerMoved = false;

let previousMouseX = 0;

let previousMouseY = 0;

let gridVisible = true;

let currentResult = null;

let selectedMesh = null;

let selectedBox = null;

let raycaster = null;

let mouse = null;



/* =========================================================
   NAVIGATION
========================================================= */

function showView(name) {

    document
        .querySelectorAll(".view")
        .forEach(view => {

            view.classList.add("hidden");

        });


    const target =
        document.getElementById(
            name + "View"
        );


    if (target) {

        target.classList.remove("hidden");

    }


    document
        .querySelectorAll(".nav-item")
        .forEach(item => {

            item.classList.remove("active");

        });


    const navItems =
        document.querySelectorAll(
            ".nav-item"
        );


    const index = {

        dashboard: 0,

        warehouse: 1,

        packages: 2,

        settings: 3

    }[name];


    if (navItems[index]) {

        navItems[index]
            .classList.add("active");

    }

}



/* =========================================================
   ROOM
========================================================= */

function saveRoom() {

    const length =
        Number(
            document.getElementById(
                "roomLength"
            ).value
        );


    const width =
        Number(
            document.getElementById(
                "roomWidth"
            ).value
        );


    const height =
        Number(
            document.getElementById(
                "roomHeight"
            ).value
        );


    if (
        length <= 0 ||
        width <= 0 ||
        height <= 0
    ) {

        alert(
            "Podaj poprawne wymiary magazynu."
        );

        return;

    }


    const volume =
        length *
        width *
        height /
        1000000;


    const base =
        length *
        width /
        10000;


    document.getElementById(
        "roomVolume"
    ).textContent =
        volume.toFixed(2) +
        " m³";


    document.getElementById(
        "roomBase"
    ).textContent =
        base.toFixed(2) +
        " m²";


    updateRoomSidebar();

    updateDashboard();

    showView("packages");


    if (
        document.querySelectorAll(
            ".package-row"
        ).length === 0
    ) {

        addPackage();

    }

}



/* =========================================================
   ROOM SIDEBAR
========================================================= */

function updateRoomSidebar() {

    const length =
        document.getElementById(
            "roomLength"
        ).value;


    const width =
        document.getElementById(
            "roomWidth"
        ).value;


    const height =
        document.getElementById(
            "roomHeight"
        ).value;


    document.getElementById(
        "sideLength"
    ).textContent =
        length
            ? length + " cm"
            : "—";


    document.getElementById(
        "sideWidth"
    ).textContent =
        width
            ? width + " cm"
            : "—";


    document.getElementById(
        "sideHeight"
    ).textContent =
        height
            ? height + " cm"
            : "—";

}



/* =========================================================
   PACKAGES
========================================================= */

function addPackage() {

    packageId++;


    const row =
        document.createElement(
            "div"
        );


    row.className =
        "package-row";


    row.innerHTML = `

        <div class="package-index">
            ${packageId}
        </div>

        <div class="field">

            <label>Nazwa</label>

            <input
                class="name"
                type="text"
                placeholder="Karton A"
                oninput="updateInventory()"
            >

        </div>


        <div class="field">

            <label>Długość</label>

            <div class="unit-input">

                <input
                    class="length"
                    type="number"
                    placeholder="80"
                    min="1"
                    oninput="updateInventory()"
                >

                <span>cm</span>

            </div>

        </div>


        <div class="field">

            <label>Szerokość</label>

            <div class="unit-input">

                <input
                    class="width"
                    type="number"
                    placeholder="40"
                    min="1"
                    oninput="updateInventory()"
                >

                <span>cm</span>

            </div>

        </div>


        <div class="field">

            <label>Wysokość</label>

            <div class="unit-input">

                <input
                    class="height"
                    type="number"
                    placeholder="30"
                    min="1"
                    oninput="updateInventory()"
                >

                <span>cm</span>

            </div>

        </div>


        <div class="field">

            <label>Ilość</label>

            <input
                class="quantity"
                type="number"
                value="1"
                min="1"
                oninput="updateInventory()"
            >

        </div>


        <button
            class="remove-button"
            onclick="removePackage(this)"
        >
            ×
        </button>

    `;


    document
        .getElementById(
            "packagesList"
        )
        .appendChild(row);


    updateInventory();

}



/* =========================================================
   REMOVE PACKAGE
========================================================= */

function removePackage(button) {

    button
        .closest(".package-row")
        .remove();


    updatePackageNumbers();

    updateInventory();

}



/* =========================================================
   PACKAGE NUMBERS
========================================================= */

function updatePackageNumbers() {

    document
        .querySelectorAll(
            ".package-row"
        )
        .forEach(
            (row, index) => {

                row.querySelector(
                    ".package-index"
                ).textContent =
                    index + 1;

            }
        );

}



/* =========================================================
   INVENTORY
========================================================= */

function updateInventory() {

    const rows =
        document.querySelectorAll(
            ".package-row"
        );


    let count = 0;

    let volume = 0;


    rows.forEach(row => {

        const l =
            Number(
                row.querySelector(
                    ".length"
                ).value
            );


        const w =
            Number(
                row.querySelector(
                    ".width"
                ).value
            );


        const h =
            Number(
                row.querySelector(
                    ".height"
                ).value
            );


        const q =
            Number(
                row.querySelector(
                    ".quantity"
                ).value
            ) || 0;


        count += q;


        if (
            l > 0 &&
            w > 0 &&
            h > 0
        ) {

            volume +=
                l *
                w *
                h *
                q /
                1000000;

        }

    });


    document.getElementById(
        "packageTypes"
    ).textContent =
        rows.length;


    document.getElementById(
        "packageCount"
    ).textContent =
        count;


    document.getElementById(
        "packageVolume"
    ).textContent =
        volume.toFixed(2) +
        " m³";


    document.getElementById(
        "dashboardPackages"
    ).textContent =
        count;


    document.getElementById(
        "emptyPackages"
    ).classList.toggle(
        "hidden",
        rows.length > 0
    );


    updateDashboard();

}



/* =========================================================
   DASHBOARD
========================================================= */

function updateDashboard() {

    const length =
        Number(
            document.getElementById(
                "roomLength"
            ).value
        ) || 0;


    const width =
        Number(
            document.getElementById(
                "roomWidth"
            ).value
        ) || 0;


    const height =
        Number(
            document.getElementById(
                "roomHeight"
            ).value
        ) || 0;


    const volume =
        length *
        width *
        height /
        1000000;


    document.getElementById(
        "dashboardRoom"
    ).textContent =
        volume
            ? volume.toFixed(2) + " m³"
            : "0 m³";

}



/* =========================================================
   OPTIMIZE
========================================================= */

async function optimize() {

    const roomLength =
        Number(
            document.getElementById(
                "roomLength"
            ).value
        );


    const roomWidth =
        Number(
            document.getElementById(
                "roomWidth"
            ).value
        );


    const roomHeight =
        Number(
            document.getElementById(
                "roomHeight"
            ).value
        );


    if (
        roomLength <= 0 ||
        roomWidth <= 0 ||
        roomHeight <= 0
    ) {

        alert(
            "Najpierw ustaw poprawne wymiary magazynu."
        );

        showView("warehouse");

        return;

    }


    const rows =
        document.querySelectorAll(
            ".package-row"
        );


    const packages = [];


    rows.forEach(row => {

        const name =
            row.querySelector(
                ".name"
            ).value.trim();


        const length =
            Number(
                row.querySelector(
                    ".length"
                ).value
            );


        const width =
            Number(
                row.querySelector(
                    ".width"
                ).value
            );


        const height =
            Number(
                row.querySelector(
                    ".height"
                ).value
            );


        const quantity =
            Number(
                row.querySelector(
                    ".quantity"
                ).value
            );


        if (
            name &&
            length > 0 &&
            width > 0 &&
            height > 0 &&
            quantity > 0
        ) {

            packages.push({

                name,

                length,

                width,

                height,

                quantity

            });

        }

    });


    if (
        packages.length === 0
    ) {

        alert(
            "Dodaj przynajmniej jeden poprawnie wypełniony towar."
        );

        showView("packages");

        return;

    }


    const loading =
        document.getElementById(
            "loading"
        );


    loading.classList.remove(
        "hidden"
    );


    try {

        const response =
            await fetch(
                "/api/optimize",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify({

                            room_length:
                                roomLength,

                            room_width:
                                roomWidth,

                            room_height:
                                roomHeight,

                            packages

                        })

                }
            );


        if (!response.ok) {

            throw new Error(
                await response.text()
            );

        }


        const result =
            await response.json();


        currentResult =
            result;


        applyResult(
            result
        );


        showView(
            "dashboard"
        );


    }
    catch (error) {

        console.error(
            error
        );


        alert(
            "Błąd optymalizacji:\n\n" +
            error.message
        );

    }
    finally {

        loading.classList.add(
            "hidden"
        );

    }

}



/* =========================================================
   RESULT
========================================================= */

function applyResult(result) {

    const placed =
        result.optimization.placed;


    const notPlaced =
        result.optimization.not_placed;


    const usage =
        result.optimization.utilization;


    document.getElementById(
        "dashboardPlaced"
    ).textContent =
        placed;


    document.getElementById(
        "dashboardUsage"
    ).textContent =
        usage + "%";


    document.getElementById(
        "miniPlaced"
    ).textContent =
        placed;


    document.getElementById(
        "miniNotPlaced"
    ).textContent =
        notPlaced;


    document.getElementById(
        "circleUsage"
    ).textContent =
        usage + "%";


    updateUsageCircle(
        usage
    );


    if (window.THREE) {

        renderWarehouse(
            result.room,
            result.placed_boxes
        );

    }
    else {

        console.warn(
            "Three.js niedostępny."
        );

    }

}



/* =========================================================
   USAGE CIRCLE
========================================================= */

function updateUsageCircle(value) {

    const circle =
        document.querySelector(
            ".usage-circle"
        );


    if (!circle) {

        return;

    }


    const safe =
        Math.max(
            0,
            Math.min(
                100,
                Number(value) || 0
            )
        );


    circle.style.setProperty(
        "--usage",
        safe + "%"
    );

}



/* =========================================================
   GET VOLUME
========================================================= */

function getBoxVolume(box) {

    return (

        Number(box.length) *

        Number(box.width) *

        Number(box.height)

    );

}



/* =========================================================
   VOLUME COLOR
========================================================= */

function getVolumeColor(
    volume,
    minVolume,
    maxVolume,
    T
) {

    let normalized = 0.5;


    if (
        maxVolume >
        minVolume
    ) {

        normalized =

            (
                volume -
                minVolume
            ) /

            (
                maxVolume -
                minVolume
            );

    }


    normalized =
        Math.max(
            0,
            Math.min(
                1,
                normalized
            )
        );


    /*
        Małe:
        niebieski

        ↓

        zielony

        ↓

        żółty

        ↓

        pomarańczowy

        ↓

        Największe:
        czerwony
    */

    const hue =

        0.62 -
        normalized *
        0.62;


    const color =
        new T.Color();


    color.setHSL(

        hue,

        0.72,

        0.52

    );


    return color;

}



/* =========================================================
   CREATE 3D LEGEND
========================================================= */

function create3DLegend(
    container
) {

    const old =
        document.getElementById(
            "warehouse3dLegend"
        );


    if (old) {

        old.remove();

    }


    const legend =
        document.createElement(
            "div"
        );


    legend.id =
        "warehouse3dLegend";


    legend.innerHTML = `

        <div class="warehouse-legend-title">
            ROZMIAR PACZKI
        </div>


        <div class="warehouse-legend-row">

            <span
                class="warehouse-legend-color"
                style="background:#2677ff;"
            ></span>

            Małe

        </div>


        <div class="warehouse-legend-row">

            <span
                class="warehouse-legend-color"
                style="background:#34b85a;"
            ></span>

            Małe / średnie

        </div>


        <div class="warehouse-legend-row">

            <span
                class="warehouse-legend-color"
                style="background:#e6c52f;"
            ></span>

            Średnie

        </div>


        <div class="warehouse-legend-row">

            <span
                class="warehouse-legend-color"
                style="background:#ed8a24;"
            ></span>

            Duże

        </div>


        <div class="warehouse-legend-row">

            <span
                class="warehouse-legend-color"
                style="background:#e53935;"
            ></span>

            Największe

        </div>

    `;


    container.appendChild(
        legend
    );

}



/* =========================================================
   RENDER WAREHOUSE
========================================================= */

function renderWarehouse(
    roomData,
    boxes
) {

    const T =
        window.THREE;


    if (!T) {

        console.error(
            "Three.js nie jest jeszcze załadowany."
        );

        return;

    }


    const container =
        document.getElementById(
            "scene"
        );


    if (!container) {

        return;

    }



    /* =====================================================
       CLEANUP RENDERER
    ===================================================== */

    if (renderer) {

        renderer.dispose();

        renderer = null;

    }


    /*
        WAŻNE:

        Nie robimy:

        container.innerHTML = "";

        ponieważ usunęłoby to również
        pasek postępu i placeholder.
    */


    const oldCanvas =
        container.querySelector(
            "canvas"
        );


    if (oldCanvas) {

        oldCanvas.remove();

    }


    const oldInfo =
        document.getElementById(
            "warehouse3dInfo"
        );


    if (oldInfo) {

        oldInfo.remove();

    }


    warehouseObjects = [];

    animatedBoxes = [];

    selectedMesh = null;

    selectedBox = null;


    raycaster =
        new T.Raycaster();


    mouse =
        new T.Vector2();



    /* =====================================================
       SCENE
    ===================================================== */

    scene =
        new T.Scene();


    scene.background =
        new T.Color(
            0x050b14
        );



    /* =====================================================
       CAMERA
    ===================================================== */

    camera =
        new T.PerspectiveCamera(

            45,

            container.clientWidth /
            Math.max(
                container.clientHeight,
                1
            ),

            0.01,

            1000

        );



    /* =====================================================
       RENDERER
    ===================================================== */

    renderer =
        new T.WebGLRenderer({

            antialias: true,

            alpha: false

        });


    renderer.setPixelRatio(

        Math.min(
            window.devicePixelRatio,
            2
        )

    );


    renderer.setSize(

        container.clientWidth,

        container.clientHeight

    );


    renderer.shadowMap.enabled =
        true;


    renderer.shadowMap.type =
        T.PCFSoftShadowMap;


    if (
        "outputColorSpace"
        in renderer
    ) {

        renderer.outputColorSpace =
            T.SRGBColorSpace;

    }


    if (
        "toneMapping"
        in renderer
    ) {

        renderer.toneMapping =
            T.ACESFilmicToneMapping;


        renderer.toneMappingExposure =
            1.1;

    }


    container.appendChild(
        renderer.domElement
    );



    /* =====================================================
       MOUSE EVENTS
    ===================================================== */

    renderer.domElement.addEventListener(

        "pointerdown",

        onScenePointerDown

    );


    renderer.domElement.addEventListener(

        "pointermove",

        onScenePointerMove

    );


    renderer.domElement.addEventListener(

        "pointerup",

        onScenePointerUp

    );


    renderer.domElement.addEventListener(

        "pointerleave",

        onScenePointerLeave

    );


    renderer.domElement.addEventListener(

        "wheel",

        onSceneWheel,

        {
            passive: true
        }

    );



    /* =====================================================
       LIGHTS
    ===================================================== */

    const hemisphere =
        new T.HemisphereLight(

            0xbfd7ff,

            0x101722,

            2.2

        );


    scene.add(
        hemisphere
    );


    const mainLight =
        new T.DirectionalLight(

            0xffffff,

            3.5

        );


    mainLight.position.set(

        8,

        12,

        6

    );


    mainLight.castShadow =
        true;


    mainLight.shadow.mapSize.width =
        2048;


    mainLight.shadow.mapSize.height =
        2048;


    mainLight.shadow.camera.near =
        0.1;


    mainLight.shadow.camera.far =
        50;


    mainLight.shadow.camera.left =
        -20;


    mainLight.shadow.camera.right =
        20;


    mainLight.shadow.camera.top =
        20;


    mainLight.shadow.camera.bottom =
        -20;


    scene.add(
        mainLight
    );


    const fillLight =
        new T.DirectionalLight(

            0x5b8cff,

            1.2

        );


    fillLight.position.set(

        -8,

        7,

        -5

    );


    scene.add(
        fillLight
    );



    /* =====================================================
       ROOM SCALE
    ===================================================== */

    const scale =
        0.01;


    const roomL =
        roomData.length *
        scale;


    const roomW =
        roomData.width *
        scale;


    const roomH =
        roomData.height *
        scale;



    /* =====================================================
       FLOOR
    ===================================================== */

    const floorGeometry =
        new T.BoxGeometry(

            roomL,

            0.08,

            roomW

        );


    const floorMaterial =
        new T.MeshStandardMaterial({

            color: 0x182332,

            roughness: 0.75,

            metalness: 0.15

        });


    const floor =
        new T.Mesh(

            floorGeometry,

            floorMaterial

        );


    floor.position.set(

        roomL / 2,

        -0.04,

        roomW / 2

    );


    floor.receiveShadow =
        true;


    scene.add(
        floor
    );



    /* =====================================================
       ROOM GROUP
    ===================================================== */

    roomGroup =
        new T.Group();


    scene.add(
        roomGroup
    );



    /* =====================================================
       GRID
    ===================================================== */

    grid =
        new T.GridHelper(

            Math.max(
                roomL,
                roomW
            ),

            20,

            0x3b82f6,

            0x243247

        );


    grid.position.set(

        roomL / 2,

        0.005,

        roomW / 2

    );


    gridVisible =
        true;


    grid.visible =
        true;


    roomGroup.add(
        grid
    );



    /* =====================================================
       ROOM FRAME
    ===================================================== */

    const roomGeometry =
        new T.BoxGeometry(

            roomL,

            roomH,

            roomW

        );


    const roomEdges =
        new T.EdgesGeometry(
            roomGeometry
        );


    const roomLines =
        new T.LineSegments(

            roomEdges,

            new T.LineBasicMaterial({

                color: 0x4f8cff,

                transparent: true,

                opacity: 0.65

            })

        );


    roomLines.position.set(

        roomL / 2,

        roomH / 2,

        roomW / 2

    );


    roomGroup.add(
        roomLines
    );



    /* =====================================================
       ROOM POSTS
    ===================================================== */

    const postMaterial =
        new T.MeshStandardMaterial({

            color: 0x26364a,

            metalness: 0.6,

            roughness: 0.35

        });


    const postRadius =
        0.035;


    const postPositions = [

        [0, 0],

        [roomL, 0],

        [0, roomW],

        [roomL, roomW]

    ];


    postPositions.forEach(
        ([x, z]) => {

            const geometry =
                new T.CylinderGeometry(

                    postRadius,

                    postRadius,

                    roomH,

                    12

                );


            const post =
                new T.Mesh(

                    geometry,

                    postMaterial

                );


            post.position.set(

                x,

                roomH / 2,

                z

            );


            post.castShadow =
                true;


            roomGroup.add(
                post
            );

        }
    );



    /* =====================================================
       SORTOWANIE PACZEK
       NAJWIĘKSZE -> NAJMNIEJSZE
    ===================================================== */

    const sortedBoxes =
        [...boxes].sort(

            (a, b) => {

                return (

                    getBoxVolume(b) -

                    getBoxVolume(a)

                );

            }

        );



    /* =====================================================
       MIN / MAX OBJĘTOŚĆ
    ===================================================== */

    const volumes =
        sortedBoxes.map(
            getBoxVolume
        );


    const minVolume =
        volumes.length
            ? Math.min(
                ...volumes
            )
            : 0;


    const maxVolume =
        volumes.length
            ? Math.max(
                ...volumes
            )
            : 0;



    /* =====================================================
       LEGEND
    ===================================================== */

    create3DLegend(
        container
    );



    /* =====================================================
       PACZKI
    ===================================================== */

    sortedBoxes.forEach(

        (box, index) => {

            const width =
                Number(box.length) *
                scale;


            const height =
                Number(box.height) *
                scale;


            const depth =
                Number(box.width) *
                scale;


            const volume =
                getBoxVolume(
                    box
                );


            /*
                KOLOR ZALEŻNY OD OBJĘTOŚCI
            */

            const color =
                getVolumeColor(

                    volume,

                    minVolume,

                    maxVolume,

                    T

                );


            const geometry =
                new T.BoxGeometry(

                    width,

                    height,

                    depth

                );


            const material =
                new T.MeshStandardMaterial({

                    color: color,

                    roughness: 0.55,

                    metalness: 0.05,

                    emissive:
                        new T.Color(
                            0x000000
                        ),

                    emissiveIntensity:
                        0

                });


            const mesh =
                new T.Mesh(

                    geometry,

                    material

                );



            /* =================================================
               TARGET POSITION
            ================================================= */

            const targetX =

                (
                    Number(box.x) +

                    Number(box.length) /
                    2

                ) *
                scale;


            const targetY =

                (
                    Number(box.z) +

                    Number(box.height) /
                    2

                ) *
                scale;


            const targetZ =

                (
                    Number(box.y) +

                    Number(box.width) /
                    2

                ) *
                scale;



            /* =================================================
               START POSITION

               Każda paczka pojawia się
               nad magazynem.
            ================================================= */

            const startY =

                roomH +

                0.8 +

                index *
                0.04;


            mesh.position.set(

                targetX,

                startY,

                targetZ

            );


            mesh.scale.set(

                0.75,

                0.75,

                0.75

            );


            mesh.castShadow =
                true;


            mesh.receiveShadow =
                true;



            /* =================================================
               EDGES
            ================================================= */

            const edgeGeometry =
                new T.EdgesGeometry(
                    geometry
                );


            const edgeMaterial =
                new T.LineBasicMaterial({

                    color: 0xffffff,

                    transparent: true,

                    opacity: 0.35

                });


            const edge =
                new T.LineSegments(

                    edgeGeometry,

                    edgeMaterial

                );


            mesh.add(
                edge
            );



            /* =================================================
               USER DATA
            ================================================= */

            mesh.userData = {

                name:
                    box.name,

                length:
                    Number(box.length),

                width:
                    Number(box.width),

                height:
                    Number(box.height),

                x:
                    Number(box.x),

                y:
                    Number(box.y),

                z:
                    Number(box.z),

                volume:
                    volume,

                originalColor:
                    color.clone(),

                originalEmissive:
                    0

            };


            scene.add(
                mesh
            );


            warehouseObjects.push(
                mesh
            );



            /* =================================================
               ANIMATION DATA
            ================================================= */

            animatedBoxes.push({

                mesh:
                    mesh,

                start: {

                    x:
                        targetX,

                    y:
                        startY,

                    z:
                        targetZ

                },

                target: {

                    x:
                        targetX,

                    y:
                        targetY,

                    z:
                        targetZ

                },

                startTime:

                    performance.now() +

                    index *
                    80,

                duration:
                    500,

                finished:
                    false

            });

        }

    );



    /* =====================================================
       3D INFO
    ===================================================== */

    const info =
        document.createElement(
            "div"
        );


    info.id =
        "warehouse3dInfo";


    info.innerHTML = `

        <strong>
            Optymalizacja 3D
        </strong>

        <span>
            ${sortedBoxes.length} paczek
        </span>

    `;


    info.style.position =
        "absolute";


    info.style.left =
        "20px";


    info.style.bottom =
        "20px";


    info.style.padding =
        "10px 14px";


    info.style.borderRadius =
        "10px";


    info.style.background =
        "rgba(5, 11, 20, 0.85)";


    info.style.border =
        "1px solid rgba(100,150,255,.25)";


    info.style.color =
        "#dbeafe";


    info.style.fontSize =
        "13px";


    info.style.pointerEvents =
        "none";


    info.style.backdropFilter =
        "blur(8px)";


    container.appendChild(
        info
    );



    /* =====================================================
       CAMERA
    ===================================================== */

    cameraTarget =
        new T.Vector3(

            roomL / 2,

            roomH * 0.35,

            roomW / 2

        );


    const diagonal =
        Math.sqrt(

            roomL * roomL +

            roomW * roomW +

            roomH * roomH

        );


    cameraDistance =
        Math.max(

            diagonal * 1.35,

            3

        );


    cameraAngleX =
        0.8;


    cameraAngleY =
        0.65;


    updateCamera();



    /* =====================================================
       PROGRESS RESET
    ===================================================== */

    const progress =
        document.getElementById(
            "warehouseProgress"
        );


    const progressLabel =
        document.getElementById(
            "warehouseProgressLabel"
        );


    const progressTitle =
        document.getElementById(
            "warehouseProgressTitle"
        );


    if (progress) {

        progress.style.width =
            "0%";

    }


    if (progressLabel) {

        progressLabel.textContent =
            `0 / ${animatedBoxes.length} · 0%`;

    }


    if (progressTitle) {

        progressTitle.textContent =
            animatedBoxes.length > 0

                ? "Rozmieszczanie paczek"

                : "Brak paczek";

    }


    /*
        Pokaż pasek tylko kiedy
        mamy paczki.
    */

    const animationInfo =
        document.getElementById(
            "warehouseAnimationInfo"
        );


    if (animationInfo) {

        animationInfo.style.display =
            animatedBoxes.length > 0
                ? "block"
                : "none";

    }



    /* =====================================================
       START ANIMATION LOOP
    ===================================================== */

    if (
        !animationLoopStarted
    ) {

        animationLoopStarted =
            true;

        animate3D();

    }

}



/* =========================================================
   TRUE ANIMATION PROGRESS
========================================================= */

function updateAnimationProgress() {

    const progress =
        document.getElementById(
            "warehouseProgress"
        );


    const label =
        document.getElementById(
            "warehouseProgressLabel"
        );


    const title =
        document.getElementById(
            "warehouseProgressTitle"
        );


    if (
        !progress ||
        !label ||
        !title
    ) {

        return;

    }


    const total =
        animatedBoxes.length;


    if (total === 0) {

        progress.style.width =
            "100%";

        label.textContent =
            "0 / 0 · 100%";

        title.textContent =
            "Brak paczek";

        return;

    }


    const now =
        performance.now();


    let totalProgress = 0;

    let completed = 0;


    /*
        Liczymy rzeczywisty stan
        każdej pojedynczej animacji.

        Dzięki temu pasek nie skacze:

        0%
        5%
        12%
        27%
        ...
        100%
    */

    animatedBoxes.forEach(
        item => {

            let itemProgress;


            if (
                item.finished
            ) {

                itemProgress =
                    1;

            }
            else if (
                now <
                item.startTime
            ) {

                itemProgress =
                    0;

            }
            else {

                itemProgress =

                    (
                        now -
                        item.startTime
                    ) /
                    item.duration;


                itemProgress =
                    Math.max(
                        0,
                        Math.min(
                            1,
                            itemProgress
                        )
                    );

            }


            totalProgress +=
                itemProgress;


            if (
                itemProgress >= 1
            ) {

                completed++;

            }

        }
    );


    let percentage =

        (
            totalProgress /
            total
        ) *
        100;


    percentage =
        Math.max(
            0,
            Math.min(
                100,
                percentage
            )
        );


    /*
        Jeżeli wszystko jest gotowe,
        wymuszamy dokładnie 100%.
    */

    if (
        completed === total
    ) {

        percentage =
            100;

    }


    progress.style.width =
        percentage.toFixed(1) +
        "%";


    label.textContent =
        `${completed} / ${total} · ${Math.round(percentage)}%`;


    if (
        completed === total
    ) {

        title.textContent =
            "Rozmieszczenie zakończone";

    }
    else {

        title.textContent =
            "Rozmieszczanie paczek";

    }

}



/* =========================================================
   CAMERA FIT
========================================================= */

function fitCamera() {

    if (
        !camera ||
        !currentResult ||
        !cameraTarget
    ) {

        return;

    }


    const room =
        currentResult.room;


    const scale =
        0.01;


    const roomL =
        room.length *
        scale;


    const roomW =
        room.width *
        scale;


    const roomH =
        room.height *
        scale;


    cameraTarget.set(

        roomL / 2,

        roomH * 0.35,

        roomW / 2

    );


    cameraAngleX =
        0.8;


    cameraAngleY =
        0.65;


    const diagonal =
        Math.sqrt(

            roomL * roomL +

            roomW * roomW +

            roomH * roomH

        );


    cameraDistance =
        Math.max(

            diagonal * 1.35,

            3

        );


    updateCamera();

}



/* =========================================================
   RESET CAMERA
========================================================= */

function resetCamera() {

    fitCamera();

}



/* =========================================================
   UPDATE CAMERA
========================================================= */

function updateCamera() {

    if (
        !camera ||
        !cameraTarget
    ) {

        return;

    }


    const horizontal =
        Math.cos(
            cameraAngleY
        ) *
        cameraDistance;


    const x =
        cameraTarget.x +

        Math.sin(
            cameraAngleX
        ) *
        horizontal;


    const y =
        cameraTarget.y +

        Math.sin(
            cameraAngleY
        ) *
        cameraDistance;


    const z =
        cameraTarget.z +

        Math.cos(
            cameraAngleX
        ) *
        horizontal;


    camera.position.set(

        x,

        y,

        z

    );


    camera.lookAt(
        cameraTarget
    );

}



/* =========================================================
   3D ANIMATION LOOP
========================================================= */

function animate3D() {

    requestAnimationFrame(
        animate3D
    );


    if (
        !renderer ||
        !scene ||
        !camera
    ) {

        return;

    }


    const now =
        performance.now();


    animatedBoxes.forEach(
        item => {

            if (
                item.finished
            ) {

                return;

            }


            if (
                now <
                item.startTime
            ) {

                return;

            }


            const elapsed =
                now -
                item.startTime;


            const progress =
                Math.min(

                    elapsed /
                    item.duration,

                    1

                );


            /*
                Ease-out cubic
            */

            const eased =
                1 -
                Math.pow(

                    1 - progress,

                    3

                );


            item.mesh.position.x =

                item.start.x +

                (
                    item.target.x -
                    item.start.x
                ) *

                eased;


            item.mesh.position.z =

                item.start.z +

                (
                    item.target.z -
                    item.start.z
                ) *

                eased;


            /*
                Lekki efekt opadania
            */

            const bounce =

                Math.sin(

                    progress *
                    Math.PI

                ) *

                0.12;


            item.mesh.position.y =

                item.start.y +

                (
                    item.target.y -
                    item.start.y
                ) *

                eased +

                bounce;


            /*
                Startuje trochę mniejsza,
                kończy w normalnym rozmiarze.
            */

            const scale =

                0.75 +

                0.25 *
                eased;


            item.mesh.scale.set(

                scale,

                scale,

                scale

            );


            if (
                progress >= 1
            ) {

                item.mesh.position.set(

                    item.target.x,

                    item.target.y,

                    item.target.z

                );


                item.mesh.scale.set(

                    1,

                    1,

                    1

                );


                item.finished =
                    true;

            }

        }
    );


    updateAnimationProgress();


    updateCamera();


    renderer.render(

        scene,

        camera

    );

}



/* =========================================================
   POINTER DOWN
========================================================= */

function onScenePointerDown(
    event
) {

    mouseDown =
        true;


    isDragging =
        true;


    pointerMoved =
        false;


    previousMouseX =
        event.clientX;


    previousMouseY =
        event.clientY;


    if (
        renderer &&
        renderer.domElement
    ) {

        try {

            renderer.domElement
                .setPointerCapture(
                    event.pointerId
                );

        }
        catch (_) {}

    }

}



/* =========================================================
   POINTER MOVE
========================================================= */

function onScenePointerMove(
    event
) {

    if (
        !isDragging
    ) {

        return;

    }


    const dx =
        event.clientX -
        previousMouseX;


    const dy =
        event.clientY -
        previousMouseY;


    if (
        Math.abs(dx) > 2 ||
        Math.abs(dy) > 2
    ) {

        pointerMoved =
            true;

    }


    cameraAngleX -=
        dx *
        0.008;


    cameraAngleY +=
        dy *
        0.008;


    cameraAngleY =
        Math.max(

            0.15,

            Math.min(
                1.45,
                cameraAngleY
            )

        );


    previousMouseX =
        event.clientX;


    previousMouseY =
        event.clientY;

}



/* =========================================================
   POINTER UP
========================================================= */

function onScenePointerUp(
    event
) {

    if (
        !mouseDown
    ) {

        return;

    }


    mouseDown =
        false;


    isDragging =
        false;


    if (
        !pointerMoved
    ) {

        onSceneClick(
            event
        );

    }


    if (
        renderer &&
        renderer.domElement
    ) {

        try {

            renderer.domElement
                .releasePointerCapture(
                    event.pointerId
                );

        }
        catch (_) {}

    }

}



/* =========================================================
   POINTER LEAVE
========================================================= */

function onScenePointerLeave() {

    isDragging =
        false;


    mouseDown =
        false;

}



/* =========================================================
   ZOOM
========================================================= */

function onSceneWheel(
    event
) {

    cameraDistance +=
        event.deltaY *
        0.012;


    cameraDistance =
        Math.max(

            1,

            Math.min(

                100,

                cameraDistance

            )

        );

}



/* =========================================================
   CLICK / RAYCAST
========================================================= */

function onSceneClick(
    event
) {

    if (
        !raycaster ||
        !camera ||
        !renderer
    ) {

        return;

    }


    const rect =
        renderer.domElement
            .getBoundingClientRect();


    mouse.x =

        (
            event.clientX -
            rect.left
        ) /

        rect.width *

        2 -

        1;


    mouse.y =

        -(
            event.clientY -
            rect.top
        ) /

        rect.height *

        2 +

        1;


    raycaster.setFromCamera(

        mouse,

        camera

    );


    const hits =
        raycaster.intersectObjects(

            warehouseObjects,

            false

        );


    if (
        hits.length === 0
    ) {

        clearSelectedBox();

        return;

    }


    selectBox(
        hits[0].object
    );

}



/* =========================================================
   SELECT BOX
========================================================= */

function selectBox(
    mesh
) {

    if (
        !mesh ||
        !mesh.userData
    ) {

        return;

    }


    selectedMesh =
        mesh;


    selectedBox =
        mesh.userData;


    const panel =
        document.getElementById(
            "selectedBoxPanel"
        );


    if (panel) {

        panel.classList.remove(
            "hidden"
        );

    }


    document.getElementById(
        "selectedBoxName"
    ).textContent =

        selectedBox.name ||
        "—";


    document.getElementById(
        "selectedLength"
    ).textContent =

        formatNumber(
            selectedBox.length
        ) +

        " cm";


    document.getElementById(
        "selectedWidth"
    ).textContent =

        formatNumber(
            selectedBox.width
        ) +

        " cm";


    document.getElementById(
        "selectedHeight"
    ).textContent =

        formatNumber(
            selectedBox.height
        ) +

        " cm";


    document.getElementById(
        "selectedPosition"
    ).textContent =

        `X: ${formatNumber(selectedBox.x)} | Y: ${formatNumber(selectedBox.y)} | Z: ${formatNumber(selectedBox.z)}`;


    resetBoxMaterial();


    if (
        mesh.material
    ) {

        mesh.material.emissive =
            new window.THREE.Color(
                0xffa726
            );


        mesh.material.emissiveIntensity =
            0.65;

    }

}



/* =========================================================
   FORMAT NUMBER
========================================================= */

function formatNumber(
    value
) {

    return Number(
        value || 0
    ).toFixed(1);

}



/* =========================================================
   RESET MATERIAL
========================================================= */

function resetBoxMaterial() {

    warehouseObjects.forEach(
        mesh => {

            if (
                !mesh.material
            ) {

                return;

            }


            mesh.material.emissive =
                new window.THREE.Color(
                    0x000000
                );


            mesh.material.emissiveIntensity =
                mesh.userData
                    .originalEmissive || 0;

        }
    );

}



/* =========================================================
   CLEAR SELECTION
========================================================= */

function clearSelectedBox() {

    resetBoxMaterial();


    selectedMesh =
        null;


    selectedBox =
        null;


    const panel =
        document.getElementById(
            "selectedBoxPanel"
        );


    if (panel) {

        panel.classList.add(
            "hidden"
        );

    }

}



/* =========================================================
   GRID
========================================================= */

function toggleGrid() {

    if (
        !grid
    ) {

        return;

    }


    gridVisible =
        !gridVisible;


    grid.visible =
        gridVisible;

}



/* =========================================================
   RESIZE
========================================================= */

function resize3D() {

    const container =
        document.getElementById(
            "scene"
        );


    if (
        !camera ||
        !renderer ||
        !container
    ) {

        return;

    }


    const width =
        container.clientWidth;


    const height =
        container.clientHeight;


    if (
        width <= 0 ||
        height <= 0
    ) {

        return;

    }


    camera.aspect =
        width /
        height;


    camera.updateProjectionMatrix();


    renderer.setSize(

        width,

        height

    );

}



/* =========================================================
   DEMO
========================================================= */

function loadDemo() {

    document.getElementById(
        "roomLength"
    ).value =
        1000;


    document.getElementById(
        "roomWidth"
    ).value =
        800;


    document.getElementById(
        "roomHeight"
    ).value =
        300;


    const packagesList =
        document.getElementById(
            "packagesList"
        );


    packagesList.innerHTML =
        "";


    packageId =
        0;


    addPackage();

    addPackage();

    addPackage();


    const rows =
        document.querySelectorAll(
            ".package-row"
        );


    const data = [

        [
            "Karton A",
            120,
            60,
            50,
            12
        ],

        [
            "Karton B",
            80,
            50,
            40,
            20
        ],

        [
            "Paczka C",
            60,
            40,
            30,
            35
        ]

    ];


    rows.forEach(
        (row, index) => {

            const item =
                data[index];


            row.querySelector(
                ".name"
            ).value =
                item[0];


            row.querySelector(
                ".length"
            ).value =
                item[1];


            row.querySelector(
                ".width"
            ).value =
                item[2];


            row.querySelector(
                ".height"
            ).value =
                item[3];


            row.querySelector(
                ".quantity"
            ).value =
                item[4];

        }
    );


    updateInventory();

    updateRoomSidebar();


    showView(
        "dashboard"
    );


    setTimeout(

        () => {

            optimize();

        },

        250

    );

}



/* =========================================================
   INIT
========================================================= */

window.addEventListener(

    "resize",

    resize3D

);


document.addEventListener(

    "DOMContentLoaded",

    () => {

        updateInventory();

    }

);

</script>


</body>

</html>